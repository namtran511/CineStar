# Copy this file to .dev.vars for local Cloudflare/Vinext development.
# Store the real key only in .dev.vars (ignored by Git) or hosting secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public browser token (pk.), never a secret Mapbox token (sk.).
MAPBOX_PUBLIC_TOKEN=
# Optional overrides for the cinema location shown in the footer.
CINEMA_NAME=
CINEMA_ADDRESS=
CINEMA_LONGITUDE=
CINEMA_LATITUDE=

# Public footer contact details. Leave empty until real channels are available.
CINEMA_EMAIL=
CINEMA_FACEBOOK_URL=
CINEMA_PHONE=

# Resend: recipients can use Gmail or any other mailbox.
# EMAIL_FROM must belong to a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# A random secret of at least 32 characters, used to protect verification codes.
EMAIL_CODE_SECRET=
APP_URL=http://localhost:5173

# Use `npm run sepay:setup` to prepare local QR payments and a random secret.
# Production always requires real SePay (never simulated customer payments).
PAYMENT_MODE=demo
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Same HMAC-SHA256 secret in SePay webhook and Cloudflare runtime Secrets.
SEPAY_WEBHOOK_SECRET=
