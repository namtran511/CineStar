# Set secrets in the server environment; never prefix the key with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public Mapbox token for the footer map. Local Vinext uses .dev.vars.
MAPBOX_PUBLIC_TOKEN=
CINEMA_NAME=
CINEMA_ADDRESS=
CINEMA_LONGITUDE=
CINEMA_LATITUDE=

# Public contact details for the footer. Local Vinext uses .dev.vars.
CINEMA_EMAIL=
CINEMA_FACEBOOK_URL=
CINEMA_PHONE=

# Local Cloudflare uses .dev.vars; production uses Worker environment secrets.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_CODE_SECRET=
APP_URL=http://localhost:5173
