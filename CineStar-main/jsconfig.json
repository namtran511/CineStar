{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["app/**/*.js", "app/**/*.jsx", "lib/**/*.js", "lib/**/*.mjs", "components/**/*.jsx", "hooks/**/*.js", "db/**/*.js", "build/**/*.js"],
  "exclude": ["node_modules", "dist", ".next", ".vinext", ".wrangler", ".sites-runtime"]
}
