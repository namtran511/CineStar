{
  "name": "cinestar",
  "main": "./build/sites-worker.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "starstart.world", "zone_name": "starstart.world", "custom_domain": true }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://starstart.world",
    "EMAIL_FROM": "CineStar <no-reply@starstart.world>",
    "GEMINI_MODEL": "gemini-2.5-flash"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cinestar-db",
    "database_id": "5e8611af-7885-4481-a38a-8ea58e8d31a2",
    "migrations_dir": "drizzle"
  }]
}
