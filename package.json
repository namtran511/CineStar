{
  "name": "cineverse-cinema-management",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "build:cloudflare": "node scripts/cloudflare-build.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config cloudflare.production.json",
    "deploy:cloudflare": "node scripts/cloudflare-deploy.mjs",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:init": "node scripts/init-db.mjs",
    "email:setup": "node scripts/setup-email.mjs",
    "sepay:setup": "node scripts/setup-sepay.mjs",
    "check": "node scripts/check-javascript.mjs",
    "test:smoke": "node scripts/smoke-test.mjs --cleanup-local-db",
    "test:checkin": "node scripts/test-checkin.mjs --cleanup-local-db",
    "test:seat-holds": "node scripts/test-seat-holds.mjs",
    "test:reviews": "node scripts/test-reviews.mjs",
    "test:membership": "node scripts/test-membership.mjs",
    "test:ai": "node scripts/test-ai.mjs",
    "test:email": "node scripts/test-email.mjs",
    "test:sepay": "node scripts/test-sepay.mjs",
    "test:sepay-api": "node scripts/test-sepay-api.mjs",
    "test:analytics": "node scripts/test-analytics.mjs",
    "test:audit": "node scripts/test-member-audit.mjs",
    "launch": "node scripts/launch.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "mapbox-gl": "^3.32.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "espree": "10.4.0",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
